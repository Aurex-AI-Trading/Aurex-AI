# ══════════════════════════════════════════════════════════
#  Aurex AI Signature Strategy — Environment Configuration
#  Copy this file to .env (NEVER commit .env to git).
#
#  All values below can ALSO be set as OS environment variables
#  using the pattern:  AUREX_<SECTION>_<KEY>=value
#  e.g.  AUREX_MT5_ACCOUNT=12345678
# ══════════════════════════════════════════════════════════

# ── MT5 Connection ────────────────────────────────────────
AUREX_MT5_ACCOUNT=0
AUREX_MT5_PASSWORD=
AUREX_MT5_SERVER=
AUREX_MT5_PATH=

# ── Trading Mode ──────────────────────────────────────────
# true  = no real orders (default — always start here)
# false = live orders sent to MT5
AUREX_TRADING_DRY_RUN=true

# ── Risk ─────────────────────────────────────────────────
AUREX_RISK_RISK_PCT=1.0

# ── Logging ──────────────────────────────────────────────
AUREX_LOGGING_LEVEL=INFO
AUREX_LOGGING_DIR=./logs
