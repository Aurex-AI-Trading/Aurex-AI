# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Aurex AI
ENVIRONMENT=development
DEBUG=false

# ── Security (CHANGE ALL IN PRODUCTION) ──────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-64-char-random-string

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aurex:aurex_dev@localhost:5432/aurex_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://app.aurexai.com

# ── Admin seed ────────────────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@aurexai.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# ── MT5 service ───────────────────────────────────────────────────────────────
MT5_RECONNECT_INTERVAL_SECONDS=30
MT5_HEALTH_CHECK_INTERVAL_SECONDS=60
MT5_MAX_RECONNECT_ATTEMPTS=5

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
